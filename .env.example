# URL do servidor local do LM Studio (endpoint compatível com OpenAI)
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions

# Nome do modelo carregado no LM Studio
LM_STUDIO_MODEL=qwen/qwen3-1.7b

# Caminho para o arquivo JSON da conta de serviço do Google
# (NUNCA suba este arquivo para o GitHub)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Nome exato da planilha no Google Sheets
NOME_PLANILHA=Teste IA para classificações

# Nome da aba principal (use "sheet1" para a primeira aba) e da aba de porcentagem
ABA_PRINCIPAL=sheet1
ABA_PORCENTAGEM=Porcentagem
